FROM docker.io/wazuh/wazuh-agent:4.14.7

USER root

RUN python3 -m ensurepip --upgrade \
    && python3 -m pip install --no-cache-dir "docker==7.1.0" \
    && python3 -m pip cache purge

COPY podman_monitor.py /opt/podman-monitor/podman_monitor.py
COPY services.d/podman-monitor/run /etc/services.d/podman-monitor/run
COPY cont-init.d/0-podman-monitor /etc/cont-init.d/0-podman-monitor
RUN chmod +x /etc/services.d/podman-monitor/run /etc/cont-init.d/0-podman-monitor
